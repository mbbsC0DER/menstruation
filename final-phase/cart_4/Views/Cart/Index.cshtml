@model CartPage
@{ ViewData["Title"] = "Shopping Cart"; decimal total = 0; }
<h1>Products</h1>
<table><tr><th>Product</th><th>Price (INR)</th><th>Action</th></tr>
@foreach (var p in Model.Products)
{
<tr><td>@p.Name</td><td>@p.Price.ToString("0.00")</td><td>
<form asp-action="Add" method="post"><input type="hidden" name="id" value="@p.Id" />
<button type="submit">Add to cart</button></form></td></tr>
}
</table><h2>Shopping Cart</h2>
@if (Model.Items.Count == 0) { <p>Your cart is empty.</p> }
else
{
<table><tr><th>Product</th><th>Quantity</th><th>Subtotal (INR)</th><th>Action</th></tr>
@foreach (var item in Model.Items)
{
var p = Model.Products.Single(p => p.Id == item.ProductId);
var subtotal = p.Price * item.Quantity;
total += subtotal;
<tr><td>@p.Name</td><td>@item.Quantity</td><td>@subtotal.ToString("0.00")</td><td>
<form asp-action="Remove" method="post"><input type="hidden" name="id" value="@p.Id" />
<button type="submit">Remove</button></form></td></tr>
}
</table>
}
<p><b>Total (INR): @total.ToString("0.00")</b></p>
<form asp-action="Clear" method="post"><button type="submit">Clear cart</button></form>
